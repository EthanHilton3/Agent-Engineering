{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm install:*)",
      "Bash(npx vitest run:*)",
      "Bash(python .claude/skills/build/workflow.py:*)"
    ],
    "deny": [
      "Read(../build-a-oneshot/**)",
      "Read(../build-b-harness/**)",
      "Read(../eval/**)",
      "Edit(spec.md)",
      "Edit(.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Glob|Grep|Bash|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check.py\"", "timeout": 600 }
        ]
      }
    ]
  }
}
